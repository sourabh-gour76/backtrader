def sell_stocks(stock_data, buy_price, capital, risk_reward=3, risk_percent=0.02):
    """
    Sells stocks based on a risk-reward ratio.

    Args:
        stock_data: DataFrame with current stock prices. Must have a 'Close' column and a unique identifier column (e.g., 'Symbol').
        buy_price: The price at which the stock was bought.
        capital: Total available capital.
        risk_reward: The desired risk-reward ratio.
        risk_percent: Percentage of capital risked on the trade.

    Returns:
        A dictionary of sell orders (stock symbol: quantity).
    """

    sell_orders = {}
    for symbol, current_price in stock_data['Close'].items():  # Iterate through each stock
        risk_amount = capital * risk_percent
        target_price = buy_price + (buy_price - (buy_price * risk_percent / buy_price)) * risk_reward # Target price based on risk-reward
        if current_price >= target_price:
            # Assuming you sell all shares at the target price
            sell_orders[symbol] = stock_data.loc[symbol, 'quantity_held'] # You'll need to track quantity_held somewhere

    return sell_orders


