import pandas as pd
import numpy as np

def buy_stocks(sensex_change, stock_data, capital, risk_percent=0.02):
    """
    Buys stocks based on Sensex change and stock performance.

    Args:
        sensex_change: Percentage change in Sensex (negative for a fall).
        stock_data: DataFrame with stock prices and other relevant data.  Must have a 'Close' column and a unique identifier column (e.g., 'Symbol').
        capital: Total available capital.
        risk_percent: Percentage of capital to risk per trade.

    Returns:
        A dictionary of buy orders (stock symbol: quantity).
    """

    if sensex_change >= 0:
        return {}  # No buys if Sensex rises or stays flat

    num_stocks_to_buy = int(abs(sensex_change) / 0.5) * 2
    if num_stocks_to_buy == 0:
        return {}

    # Calculate stock returns (replace with your actual return calculation if needed)
    stock_data['Returns'] = stock_data['Close'].pct_change()

    # Sort stocks by returns (most negative first)
    sorted_stocks = stock_data.sort_values('Returns')

    buy_orders = {}
    for i in range(min(num_stocks_to_buy, len(sorted_stocks))):
        stock = sorted_stocks.iloc[i]  # Get the i-th most negative stock
        risk_amount = capital * risk_percent
        buy_price = stock['Close'] # Assuming you buy at the current close price.  Modify if needed.
        quantity = int(risk_amount / buy_price) # Integer number of shares
        if quantity > 0: # Only buy if we can afford at least one share
            buy_orders[stock.name] = quantity # Assuming stock_data index is the stock symbol

    return buy_orders



